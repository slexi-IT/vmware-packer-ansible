# Rocky Linux 10 golden image - unattended install (vSphere), rendered by playbooks/build-image.yml
# No hostname and no per-VM settings: those come from VMware guest customization when a VM is
# deployed. The fixed address below belongs to the build VM and is removed when sealing.
cmdline
# Offline build: every package comes from the ISO, no network repositories
cdrom
lang en_US.UTF-8
keyboard us
timezone {{ image_timezone }} --utc
# Fixed build address from image.yml (no DHCP on the build network); removed again when sealing
{% set n = image_build_network %}
{% set bits = '1' * (n.prefix | int) ~ '0' * (32 - (n.prefix | int)) %}
network --bootproto=static --ip={{ n.ip }} --netmask={{ [bits[0:8], bits[8:16], bits[16:24], bits[24:32]] | map('int', base=2) | join('.') }} --gateway={{ n.gateway }} --nameserver={{ n.dns | join(',') }} --device=link --activate --hostname=localhost.localdomain

# Per-build root password: Ansible logs in with it through VMware Tools (guest operations).
# The last sealing step replaces it with image_root_password_hash from image.yml and deletes the
# copies of this kickstart that Anaconda leaves in /root.
rootpw --plaintext {{ build_password }}

selinux --enforcing
firewall --enabled --service=ssh
firstboot --disable

# PVSCSI disk
ignoredisk --only-use=sda
zerombr
clearpart --all --initlabel --drives=sda
autopart --type=lvm --nohome
bootloader --timeout=1

%packages
@^minimal-environment
%end

# Use the OEMDRV CD from inside the new system: install the RPMs shipped on it
# (open-vm-tools is not on the minimal ISO) and run init.sh, all without network access
%post --nochroot --interpreter=/bin/bash --erroronfail --log=/mnt/sysroot/root/ks-init.log
set -euxo pipefail
mkdir -p /mnt/sysroot/mnt/oemdrv /mnt/sysroot/mnt/iso
mount -o ro /dev/disk/by-label/OEMDRV /mnt/sysroot/mnt/oemdrv
# The install ISO is still in the drive; dnf takes the RPMs' dependencies from it
mount -o ro "/dev/disk/by-label/{{ image_iso_volume_id }}" /mnt/sysroot/mnt/iso
# The * must be expanded inside the new system, where the CD is at /mnt/oemdrv
chroot /mnt/sysroot bash -c "dnf -y --disablerepo='*' \
  --repofrompath=iso,file:///mnt/iso/Minimal --setopt=iso.gpgcheck=1 \
  --setopt=iso.gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-Rocky-10 \
  --setopt=install_weak_deps=False install /mnt/oemdrv/*.rpm"
chroot /mnt/sysroot systemctl enable vmtoolsd
chroot /mnt/sysroot bash /mnt/oemdrv/init.sh
umount /mnt/sysroot/mnt/oemdrv /mnt/sysroot/mnt/iso
rmdir /mnt/sysroot/mnt/oemdrv /mnt/sysroot/mnt/iso
%end

# Completion marker: Ansible checks it through VMware Tools before configuring the VM, since a
# VM that powers off for any other reason (crash, Anaconda halting on an error) looks the same.
%post --interpreter=/bin/bash --erroronfail --log=/root/ks-final.log
set -euxo pipefail
echo "{{ build_marker }}" > /root/build-complete
%end

poweroff
